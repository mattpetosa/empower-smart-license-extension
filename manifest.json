{
  "manifest_version": 3,
  "name": "Empower Smart License Extension",
  "short_name": "Smart License",
  "version": "0.1.0",
  "description": "Turns a Waters Salesforce order's Assets list into the License Cleaner's Simple CSV for the Licensing Portal, in your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["https://waters.lightning.force.com/*"],
  "background": { "service_worker": "src/background.js" },
  "side_panel": { "default_path": "src/panel.html" },
  "action": {
    "default_title": "Empower Smart License Extension",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
